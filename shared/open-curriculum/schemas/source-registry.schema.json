{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongxuan.dev/schemas/source-registry.schema.json",
  "title": "TongXuan content source registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "lastVerifiedAt", "allowedLegalStatuses", "sources"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "policyId": { "$ref": "open-curriculum.schema.json#/$defs/id" },
    "lastVerifiedAt": { "type": "string", "format": "date" },
    "allowedLegalStatuses": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"] }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } }
  },
  "$defs": {
    "permission": { "enum": ["YES", "NO", "NOT_ALLOWED", "CONDITIONAL", "UNKNOWN"] },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "name", "authorityLevel", "owner", "officialUrl", "purpose", "license", "commercialUse", "modificationAllowed", "redistributionAllowed", "attributionRequired", "shareAlike", "rawIngestionAllowed", "publicRepoAllowed", "derivativeUseAllowed", "validationOnly", "itemLevelRightsRequired", "curriculumRole", "evidenceRole", "legalStatus", "rightsEvidence", "rightsDecision", "constraints", "lastVerifiedAt", "notes"],
      "properties": {
        "sourceId": { "$ref": "open-curriculum.schema.json#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "authorityLevel": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "officialUrl": { "type": "string", "format": "uri" },
        "purpose": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "scope", "verifiedAt"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "format": "uri" },
            "scope": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "format": "date" }
          }
        },
        "commercialUse": { "$ref": "#/$defs/permission" },
        "modificationAllowed": { "$ref": "#/$defs/permission" },
        "redistributionAllowed": { "$ref": "#/$defs/permission" },
        "attributionRequired": { "$ref": "#/$defs/permission" },
        "shareAlike": { "$ref": "#/$defs/permission" },
        "rawIngestionAllowed": { "$ref": "#/$defs/permission" },
        "publicRepoAllowed": { "$ref": "#/$defs/permission" },
        "derivativeUseAllowed": { "$ref": "#/$defs/permission" },
        "validationOnly": { "type": "boolean" },
        "itemLevelRightsRequired": { "type": "boolean" },
        "curriculumRole": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceRole": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "legalStatus": { "enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"] },
        "rightsEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rightsEvidence" }
        },
        "rightsDecision": { "$ref": "#/$defs/rightsDecision" },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "lastVerifiedAt": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "rightsEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "evidenceKind", "evidenceUrl", "locator", "observedAt", "captureMethod", "supportsClaims", "claimSummary"],
      "properties": {
        "evidenceId": { "$ref": "open-curriculum.schema.json#/$defs/id" },
        "evidenceKind": { "enum": ["LICENSE_NOTICE", "TERMS_OF_USE", "SOURCE_DESCRIPTION", "PROJECT_POLICY", "INACCESSIBLE_PRIMARY_SOURCE"] },
        "evidenceUrl": { "type": "string", "format": "uri" },
        "locator": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date" },
        "captureMethod": { "enum": ["HTTP_RESPONSE_TEXT_SHA256", "BROWSER_RENDERED_REFERENCE", "POLICY_TEXT"] },
        "supportsClaims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["SOURCE_DESCRIPTION", "LICENSE_IDENTITY", "COMMERCIAL_USE", "MODIFICATION", "REDISTRIBUTION", "ATTRIBUTION", "SHARE_ALIKE", "RAW_INGESTION", "PUBLIC_REPOSITORY", "DERIVATIVE_USE", "ITEM_LEVEL_LICENSE", "AUDIO_LICENSE_SCOPE", "PROJECT_POLICY", "CONTENT_LICENSE_SEPARATION"] }
        },
        "responseSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "responseBytes": { "type": "integer", "minimum": 1 },
        "claimSummary": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "captureMethod": { "const": "HTTP_RESPONSE_TEXT_SHA256" } }, "required": ["captureMethod"] },
          "then": { "required": ["responseSha256", "responseBytes"] }
        },
        {
          "if": { "properties": { "captureMethod": { "enum": ["BROWSER_RENDERED_REFERENCE", "POLICY_TEXT"] } }, "required": ["captureMethod"] },
          "then": { "not": { "anyOf": [{ "required": ["responseSha256"] }, { "required": ["responseBytes"] }] } }
        }
      ]
    },
    "rightsDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "outcome", "rationale", "evidenceIds"],
      "properties": {
        "policyId": { "$ref": "open-curriculum.schema.json#/$defs/id" },
        "outcome": { "enum": ["ALLOW_WITH_ITEM_CHECKS", "REFERENCE_ONLY", "BLOCK", "UNKNOWN_BLOCKED"] },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "open-curriculum.schema.json#/$defs/id" } }
      }
    }
  }
}
