{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongxuan.dev/schemas/five-lesson-experiment-proposal.schema.json",
  "title": "TongXuan five-lesson experiment proposal",
  "description": "Planning-only two-variant proposal. It does not approve targets, mutate the graph, or create executable lessons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "proposalId",
    "approvalStatus",
    "authority",
    "scope",
    "licenseNotice",
    "sourceCatalog",
    "evidenceCatalog",
    "skillCatalog",
    "candidateTargetCatalog",
    "variants",
    "ownerDecision"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "documentType": { "const": "PROTOTYPE_CURRICULUM_EXPERIMENT_PROPOSAL" },
    "proposalId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "approvalStatus": { "const": "PROPOSED" },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposer", "advisoryReviewer", "finalHumanApprover"],
      "properties": {
        "proposer": { "const": "CODEX_AI_PROPOSER" },
        "advisoryReviewer": { "const": "ADVERSARIAL_ARCHITECT_REVIEW_ADVISORY_ONLY" },
        "finalHumanApprover": { "const": "WEBBER_FINAL_HUMAN_CURRICULUM_APPROVER" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimentType",
        "formalCourseClaim",
        "executableLessonsCreated",
        "approvedGraphMutated",
        "ocacMaterialConsulted",
        "contaminationAssessment",
        "writingTargets"
      ],
      "properties": {
        "experimentType": { "const": "FEASIBILITY_PROTOTYPE_ONLY" },
        "formalCourseClaim": { "const": false },
        "executableLessonsCreated": { "const": false },
        "approvedGraphMutated": { "const": false },
        "ocacMaterialConsulted": { "const": false },
        "contaminationAssessment": { "type": "string", "minLength": 1 },
        "writingTargets": { "type": "array", "maxItems": 0 }
      }
    },
    "licenseNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cedictLicense", "attribution", "changes", "mitAppliesToCedictData"],
      "properties": {
        "cedictLicense": { "const": "CC BY-SA 4.0" },
        "attribution": { "type": "string", "minLength": 1 },
        "changes": { "type": "string", "minLength": 1 },
        "mitAppliesToCedictData": { "const": false }
      }
    },
    "sourceCatalog": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "status", "useMode", "rawDatasetIngested", "permittedUse"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["GREEN", "YELLOW", "RED", "UNKNOWN"] },
          "useMode": { "enum": ["CONTENT_SOURCE", "REFERENCE_ONLY"] },
          "rawDatasetIngested": { "const": false },
          "license": { "type": ["string", "null"] },
          "permittedUse": { "type": "string", "minLength": 1 },
          "prohibitedUse": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "sourceId", "category", "reference", "claim", "useMode", "rawContentIncluded"],
        "properties": {
          "evidenceId": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "category": {
            "enum": [
              "OFFICIAL_LEVEL_FRAMEWORK",
              "OFFICIAL_GRAMMAR_FRAMEWORK",
              "CHILD_CONTEXT_REFERENCE",
              "OPEN_LEXICAL_ITEM",
              "TONGXUAN_HYPOTHESIS",
              "ENGINEERING_CONTRACT_REFERENCE"
            ]
          },
          "reference": { "type": "string", "format": "uri" },
          "claim": { "type": "string", "minLength": 1 },
          "useMode": { "enum": ["CONTENT_SOURCE", "REFERENCE_ONLY", "AUTHORED_HYPOTHESIS"] },
          "rawContentIncluded": { "const": false }
        }
      }
    },
    "skillCatalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skillTarget" }
    },
    "candidateTargetCatalog": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidateTarget" }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/variant" }
    },
    "ownerDecision": { "type": "null" }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sourceUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "evidenceId", "useMode", "reference", "rawContentIncluded"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "useMode": { "enum": ["CONTENT_SOURCE", "REFERENCE_ONLY", "AUTHORED_HYPOTHESIS"] },
        "reference": { "type": "string", "format": "uri" },
        "rawContentIncluded": { "const": false },
        "license": { "type": ["string", "null"] },
        "attribution": { "type": ["string", "null"] },
        "shareAlike": { "type": ["boolean", "null"] }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description", "evidenceIds"],
      "properties": {
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rating", "rationale", "limitations"],
      "properties": {
        "rating": { "enum": ["LOW", "MEDIUM", "HIGH"] },
        "rationale": { "type": "string", "minLength": 1 },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "skillTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approvalStatus",
        "capability",
        "whyThis",
        "evidenceIds",
        "sourceProvenance",
        "prerequisites",
        "receptiveRequirement",
        "productiveRequirement",
        "writingRequired",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "approvalStatus": { "const": "PROPOSED" },
        "capability": { "type": "string", "minLength": 1 },
        "whyThis": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceUse" } },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "receptiveRequirement": { "$ref": "#/$defs/requirement" },
        "productiveRequirement": { "$ref": "#/$defs/requirement" },
        "writingRequired": { "const": false },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "candidateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetType",
        "approvalStatus",
        "candidateForm",
        "pinyin",
        "zhuyinStatus",
        "meaning",
        "whyThis",
        "whyNow",
        "evidenceIds",
        "sourceProvenance",
        "prerequisites",
        "receptiveRequirement",
        "productiveRequirement",
        "writingRequired",
        "alternatives",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "targetType": { "enum": ["VOCABULARY", "GRAMMAR", "CHARACTER"] },
        "approvalStatus": { "const": "PROPOSED" },
        "candidateForm": { "type": "string", "minLength": 1 },
        "pinyin": { "type": ["string", "null"] },
        "zhuyinStatus": { "enum": ["NOT_PROPOSED", "SOURCE_INSUFFICIENT"] },
        "meaning": { "type": "string", "minLength": 1 },
        "whyThis": { "type": "string", "minLength": 1 },
        "whyNow": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceUse" } },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "receptiveRequirement": { "$ref": "#/$defs/requirement" },
        "productiveRequirement": { "$ref": "#/$defs/requirement" },
        "writingRequired": { "const": false },
        "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newVocabularyCount",
        "newGrammarCount",
        "newCharacterRecognitionCount",
        "newWritingCount",
        "newPhoneticSyllableCount",
        "riskFlags"
      ],
      "properties": {
        "newVocabularyCount": { "type": "integer", "minimum": 0 },
        "newGrammarCount": { "type": "integer", "minimum": 0 },
        "newCharacterRecognitionCount": { "type": "integer", "minimum": 0 },
        "newWritingCount": { "const": 0 },
        "newPhoneticSyllableCount": { "type": "integer", "minimum": 0 },
        "riskFlags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "title",
        "skillTargets",
        "vocabularyTargets",
        "grammarTargets",
        "characterTargets",
        "newVocabularyTargets",
        "newGrammarTargets",
        "newCharacterTargets",
        "recycledTargetIds",
        "listeningComprehensionTargets",
        "visualMeaningComprehensionTargets",
        "spokenProductionTargets",
        "characterRecognitionTargets",
        "scriptReadingTargets",
        "writingTargets",
        "phoneticTargetSyllables",
        "srsReviewTargets",
        "prerequisites",
        "whyNow",
        "orderRationale",
        "alternatives",
        "confidence",
        "adaptiveLearningFit",
        "load"
      ],
      "properties": {
        "slot": { "enum": ["A", "B", "C", "D", "E"] },
        "title": { "type": "string", "minLength": 1 },
        "skillTargets": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "vocabularyTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "grammarTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "characterTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "newVocabularyTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "newGrammarTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "newCharacterTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "recycledTargetIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "listeningComprehensionTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "visualMeaningComprehensionTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "spokenProductionTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "characterRecognitionTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "scriptReadingTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "writingTargets": { "type": "array", "maxItems": 0 },
        "phoneticTargetSyllables": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "srsReviewTargets": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "whyNow": { "type": "string", "minLength": 1 },
        "orderRationale": { "type": "string", "minLength": 1 },
        "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "confidence": { "$ref": "#/$defs/confidence" },
        "adaptiveLearningFit": { "type": "string", "minLength": 1 },
        "load": { "$ref": "#/$defs/load" }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "label",
        "sequence",
        "lessons",
        "strengths",
        "risks",
        "cognitiveLoadSummary",
        "adaptiveLearningFit",
        "confidence"
      ],
      "properties": {
        "variantId": { "enum": ["A", "B"] },
        "label": { "type": "string", "minLength": 1 },
        "sequence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["A", "B", "C", "D", "E"] }
        },
        "lessons": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/lesson" }
        },
        "strengths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "risks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cognitiveLoadSummary": { "type": "string", "minLength": 1 },
        "adaptiveLearningFit": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
