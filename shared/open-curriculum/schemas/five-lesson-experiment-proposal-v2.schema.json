{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongxuan.dev/schemas/five-lesson-experiment-proposal-v2.schema.json",
  "title": "TongXuan five-lesson experiment proposal v2 relationship contract",
  "description": "Planning-only two-variant proposal. Typed relationship fields separate blocking hard prerequisites from nonblocking sequence, recycled context, and scaffoldable assumptions. It does not approve targets, mutate the graph, or create executable lessons.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "documentType",
    "proposalId",
    "approvalStatus",
    "authority",
    "scope",
    "licenseNotice",
    "sourceCatalog",
    "evidenceCatalog",
    "skillCatalog",
    "candidateTargetCatalog",
    "lexicalDecisionGates",
    "variants",
    "ownerDecision"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0"
    },
    "documentType": {
      "const": "PROTOTYPE_CURRICULUM_EXPERIMENT_PROPOSAL"
    },
    "proposalId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "approvalStatus": {
      "const": "PROPOSED"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposer",
        "advisoryReviewer",
        "finalHumanApprover"
      ],
      "properties": {
        "proposer": {
          "const": "CODEX_AI_PROPOSER"
        },
        "advisoryReviewer": {
          "const": "ADVERSARIAL_ARCHITECT_REVIEW_ADVISORY_ONLY"
        },
        "finalHumanApprover": {
          "const": "WEBBER_FINAL_HUMAN_CURRICULUM_APPROVER"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experimentType",
        "formalCourseClaim",
        "executableLessonsCreated",
        "approvedGraphMutated",
        "ocacMaterialConsulted",
        "contaminationAssessment",
        "writingTargets"
      ],
      "properties": {
        "experimentType": {
          "const": "FEASIBILITY_PROTOTYPE_ONLY"
        },
        "formalCourseClaim": {
          "const": false
        },
        "executableLessonsCreated": {
          "const": false
        },
        "approvedGraphMutated": {
          "const": false
        },
        "ocacMaterialConsulted": {
          "const": false
        },
        "contaminationAssessment": {
          "type": "string",
          "minLength": 1
        },
        "writingTargets": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "licenseNotice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cedictLicense",
        "attribution",
        "changes",
        "mitAppliesToCedictData"
      ],
      "properties": {
        "cedictLicense": {
          "const": "CC BY-SA 4.0"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "changes": {
          "type": "string",
          "minLength": 1
        },
        "mitAppliesToCedictData": {
          "const": false
        }
      }
    },
    "sourceCatalog": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "status",
          "useMode",
          "rawDatasetIngested",
          "permittedUse"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "GREEN",
              "YELLOW",
              "RED",
              "UNKNOWN"
            ]
          },
          "useMode": {
            "enum": [
              "CONTENT_SOURCE",
              "REFERENCE_ONLY"
            ]
          },
          "rawDatasetIngested": {
            "const": false
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "permittedUse": {
            "type": "string",
            "minLength": 1
          },
          "prohibitedUse": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "sourceId",
          "category",
          "reference",
          "claim",
          "useMode",
          "rawContentIncluded"
        ],
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "OFFICIAL_LEVEL_FRAMEWORK",
              "OFFICIAL_GRAMMAR_FRAMEWORK",
              "CHILD_CONTEXT_REFERENCE",
              "OPEN_LEXICAL_ITEM",
              "TONGXUAN_HYPOTHESIS",
              "ENGINEERING_CONTRACT_REFERENCE"
            ]
          },
          "reference": {
            "type": "string",
            "format": "uri"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "useMode": {
            "enum": [
              "CONTENT_SOURCE",
              "REFERENCE_ONLY",
              "AUTHORED_HYPOTHESIS"
            ]
          },
          "rawContentIncluded": {
            "const": false
          }
        }
      }
    },
    "skillCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/skillTarget"
      }
    },
    "candidateTargetCatalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidateTarget"
      }
    },
    "variants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "ownerDecision": {
      "type": "null"
    },
    "lexicalDecisionGates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/lexicalDecisionGate"
      },
      "description": "Unresolved lexical choices remain explicit Owner gates and cannot be treated as selected lesson targets."
    }
  },
  "$defs": {
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sourceUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "evidenceId",
        "useMode",
        "reference",
        "rawContentIncluded"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "useMode": {
          "enum": [
            "CONTENT_SOURCE",
            "REFERENCE_ONLY",
            "AUTHORED_HYPOTHESIS"
          ]
        },
        "reference": {
          "type": "string",
          "format": "uri"
        },
        "rawContentIncluded": {
          "const": false
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "shareAlike": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "description",
        "evidenceIds"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating",
        "rationale",
        "limitations"
      ],
      "properties": {
        "rating": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "skillTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "approvalStatus",
        "capability",
        "whyThis",
        "evidenceIds",
        "sourceProvenance",
        "hardPrerequisites",
        "receptiveRequirement",
        "productiveRequirement",
        "writingRequired",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "approvalStatus": {
          "const": "PROPOSED"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "whyThis": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "sourceProvenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceUse"
          }
        },
        "receptiveRequirement": {
          "$ref": "#/$defs/requirement"
        },
        "productiveRequirement": {
          "$ref": "#/$defs/requirement"
        },
        "writingRequired": {
          "const": false
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "hardPrerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hardPrerequisite"
          },
          "description": "A justified capability-level HARD_PREREQUISITE edge with a rationale. A skill-level edge is not a lesson-entry gate unless it is separately listed in that lesson's hardPrerequisites. Previous lesson appearance alone creates no edge."
        }
      }
    },
    "candidateTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "targetType",
        "approvalStatus",
        "candidateForm",
        "pinyin",
        "zhuyinStatus",
        "meaning",
        "whyThis",
        "whyNow",
        "evidenceIds",
        "sourceProvenance",
        "hardPrerequisites",
        "receptiveRequirement",
        "productiveRequirement",
        "writingRequired",
        "alternatives",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "targetType": {
          "enum": [
            "VOCABULARY",
            "GRAMMAR",
            "CHARACTER"
          ]
        },
        "approvalStatus": {
          "const": "PROPOSED"
        },
        "candidateForm": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": [
            "string",
            "null"
          ]
        },
        "zhuyinStatus": {
          "enum": [
            "NOT_PROPOSED",
            "SOURCE_INSUFFICIENT"
          ]
        },
        "meaning": {
          "type": "string",
          "minLength": 1
        },
        "whyThis": {
          "type": "string",
          "minLength": 1
        },
        "whyNow": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "sourceProvenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceUse"
          }
        },
        "receptiveRequirement": {
          "$ref": "#/$defs/requirement"
        },
        "productiveRequirement": {
          "$ref": "#/$defs/requirement"
        },
        "writingRequired": {
          "const": false
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "hardPrerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hardPrerequisite"
          },
          "description": "A justified target-composition HARD_PREREQUISITE edge with a rationale. It identifies a needed linguistic component for this target; it is not a lesson-entry gate unless it is separately listed in that lesson's hardPrerequisites. Previous lesson appearance alone creates no edge."
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "newVocabularyCount",
        "newGrammarCount",
        "newCharacterRecognitionCount",
        "newWritingCount",
        "newPhoneticSyllableCount",
        "riskFlags"
      ],
      "properties": {
        "newVocabularyCount": {
          "type": "integer",
          "minimum": 0
        },
        "newGrammarCount": {
          "type": "integer",
          "minimum": 0
        },
        "newCharacterRecognitionCount": {
          "type": "integer",
          "minimum": 0
        },
        "newWritingCount": {
          "const": 0
        },
        "newPhoneticSyllableCount": {
          "type": "integer",
          "minimum": 0
        },
        "riskFlags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "title",
        "skillTargets",
        "vocabularyTargets",
        "grammarTargets",
        "characterTargets",
        "newVocabularyTargets",
        "newGrammarTargets",
        "newCharacterTargets",
        "recycledTargetIds",
        "listeningComprehensionTargets",
        "visualMeaningComprehensionTargets",
        "spokenProductionTargets",
        "characterRecognitionTargets",
        "scriptReadingTargets",
        "writingTargets",
        "phoneticTargetSyllables",
        "srsReviewTargets",
        "hardPrerequisites",
        "whyNow",
        "orderRationale",
        "alternatives",
        "confidence",
        "adaptiveLearningFit",
        "load",
        "pedagogicalPredecessors",
        "recycledContext",
        "assumedKnown"
      ],
      "properties": {
        "slot": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "skillTargets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "vocabularyTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "grammarTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "characterTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "newVocabularyTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "newGrammarTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "newCharacterTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "recycledTargetIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "listeningComprehensionTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "visualMeaningComprehensionTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "spokenProductionTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "characterRecognitionTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scriptReadingTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writingTargets": {
          "type": "array",
          "maxItems": 0
        },
        "phoneticTargetSyllables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "srsReviewTargets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "whyNow": {
          "type": "string",
          "minLength": 1
        },
        "orderRationale": {
          "type": "string",
          "minLength": 1
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "adaptiveLearningFit": {
          "type": "string",
          "minLength": 1
        },
        "load": {
          "$ref": "#/$defs/load"
        },
        "hardPrerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hardPrerequisite"
          },
          "description": "The only lesson relationship that may block entry. Every item must be necessary to understand or perform this lesson and must give a rationale."
        },
        "pedagogicalPredecessors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pedagogicalPredecessor"
          },
          "description": "Chosen instructional order only; never a learner-state gate."
        },
        "recycledContext": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Targets or skills intentionally reused as context; reuse never implies a hard prerequisite."
        },
        "assumedKnown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumedKnown"
          },
          "description": "Previously introduced targets that may be absent; each absence must have a scaffold and cannot block lesson entry."
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variantId",
        "label",
        "sequence",
        "lessons",
        "strengths",
        "risks",
        "cognitiveLoadSummary",
        "adaptiveLearningFit",
        "confidence"
      ],
      "properties": {
        "variantId": {
          "enum": [
            "A",
            "B"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ]
          }
        },
        "lessons": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        },
        "strengths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "risks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cognitiveLoadSummary": {
          "type": "string",
          "minLength": 1
        },
        "adaptiveLearningFit": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "hardPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "rationale"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "description": "Why a learner without this target cannot reasonably understand or perform the dependent capability."
        }
      }
    },
    "pedagogicalPredecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonSlot",
        "rationale"
      ],
      "properties": {
        "lessonSlot": {
          "enum": [
            "A",
            "B",
            "C",
            "D",
            "E"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "assumedKnown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "scaffoldIfMissing"
      ],
      "properties": {
        "targetId": {
          "type": "string",
          "minLength": 1
        },
        "scaffoldIfMissing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lexicalOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionId",
        "form",
        "pinyin",
        "dictionarySense",
        "evidenceIds",
        "directFrameProbe",
        "directNominalUse",
        "childFamiliarity",
        "semanticBurden",
        "genericUseRequiresClassifier",
        "requiresAdditionalGrammarTarget",
        "comparisonNote"
      ],
      "properties": {
        "optionId": {
          "type": "string",
          "minLength": 1
        },
        "form": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "dictionarySense": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "$ref": "#/$defs/evidenceIds"
        },
        "directFrameProbe": {
          "type": "string",
          "minLength": 1
        },
        "directNominalUse": {
          "enum": [
            "VERIFIED",
            "OWNER_REVIEW_REQUIRED",
            "OWNER_DECISION_ACCEPTED"
          ]
        },
        "childFamiliarity": {
          "enum": [
            "EVIDENCE_SUPPORTED",
            "UNVERIFIED"
          ]
        },
        "semanticBurden": {
          "enum": [
            "EVIDENCE_SUPPORTED_LOW",
            "OWNER_REVIEW_REQUIRED",
            "OWNER_DECISION_ACCEPTED_LOW"
          ]
        },
        "genericUseRequiresClassifier": {
          "const": false
        },
        "requiresAdditionalGrammarTarget": {
          "const": false
        },
        "comparisonNote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lexicalDecisionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "lessonSlot",
        "status",
        "selectedTargetId",
        "communicativeFrame",
        "options",
        "decisionCriteria",
        "comparisonConclusion",
        "grammarScope"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "lessonSlot": {
          "const": "C"
        },
        "status": {
          "enum": [
            "OWNER_LEXICAL_DECISION_REQUIRED",
            "OWNER_CURRICULUM_DECISION"
          ]
        },
        "selectedTargetId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "communicativeFrame": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/lexicalOption"
          }
        },
        "decisionCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "comparisonConclusion": {
          "type": "string",
          "minLength": 1
        },
        "grammarScope": {
          "type": "string",
          "minLength": 1
        },
        "selectionSource": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "recordId",
            "sourceProposalId",
            "sourceProposalSha256"
          ],
          "properties": {
            "type": {
              "const": "OWNER_CURRICULUM_DECISION"
            },
            "recordId": {
              "type": "string",
              "minLength": 1
            },
            "sourceProposalId": {
              "type": "string",
              "minLength": 1
            },
            "sourceProposalSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selectedTargetId": {
                "type": "null"
              }
            },
            "required": [
              "selectedTargetId"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "OWNER_LEXICAL_DECISION_REQUIRED"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "OWNER_CURRICULUM_DECISION"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "selectionSource"
            ],
            "properties": {
              "selectedTargetId": {
                "type": "string",
                "minLength": 1
              },
              "selectionSource": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "OWNER_LEXICAL_DECISION_REQUIRED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "selectedTargetId": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
