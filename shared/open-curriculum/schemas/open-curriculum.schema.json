{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tongxuan.dev/schemas/open-curriculum.schema.json",
  "title": "TongXuan Open Curriculum graph and candidate pack",
  "description": "Evidence-constrained graph/pack schema. Passing structural validation never substitutes for human or Architect approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "packId", "publicationStatus", "graph", "lessons", "validationPolicy"],
  "properties": {
    "schemaVersion": { "const": "1.4" },
    "documentType": { "const": "CURRICULUM_PACK" },
    "packId": { "$ref": "#/$defs/id" },
    "publicationStatus": { "enum": ["PROPOSED", "PUBLISHABLE"] },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "vocabulary", "grammar", "characters"],
      "properties": {
        "skills": { "type": "array", "items": { "$ref": "#/$defs/skillNode" } },
        "vocabulary": { "type": "array", "items": { "$ref": "#/$defs/vocabularyNode" } },
        "grammar": { "type": "array", "items": { "$ref": "#/$defs/grammarNode" } },
        "characters": { "type": "array", "items": { "$ref": "#/$defs/characterNode" } }
      }
    },
    "lessons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lesson" } },
    "validationPolicy": { "$ref": "#/$defs/validationPolicy" },
    "curriculumChangeProposals": { "type": "array", "items": { "$ref": "#/$defs/curriculumChangeProposal" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$" },
    "level": { "type": "integer", "minimum": 1, "maximum": 7 },
    "approvalStatus": { "enum": ["PROPOSED", "EVIDENCE_CHECKED", "ARCHITECT_APPROVED", "REJECTED"] },
    "evidenceClaim": { "enum": ["TARGET_DIFFICULTY", "CURRICULUM_AUTHORITY", "VOCABULARY_FREQUENCY", "RECEPTIVE_REQUIREMENT", "PRODUCTIVE_REQUIREMENT", "RECEPTIVE_PRODUCTIVE_POLICY", "EXPECTED_COGNITIVE_LOAD", "PROPOSAL_CONFIDENCE"] },
    "authorityType": { "enum": ["CURRICULUM_FRAMEWORK", "OFFICIAL_ASSESSMENT", "OPEN_CORPUS", "LEXICAL_REFERENCE", "AUTHORED_RATIONALE", "EXPERT_REVIEW", "LEARNER_VALIDATION", "OTHER"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "sourceId", "authorityType", "evidenceType", "reference", "rationale", "recordedAt", "reviewStatus"],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "authorityType": { "$ref": "#/$defs/authorityType" },
        "evidenceType": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "supportsClaims": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceClaim" } },
        "recordedAt": { "type": "string", "format": "date" },
        "reviewStatus": { "$ref": "#/$defs/approvalStatus" }
      }
    },
    "difficultyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "evidenceIds", "rationale"],
      "properties": {
        "level": { "$ref": "#/$defs/level" },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "useMode", "reference", "rawContentIncluded", "itemLicenseVerified"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" },
        "useMode": { "enum": ["EVIDENCE_REFERENCE", "CONTENT_SOURCE"] },
        "reference": { "type": "string", "minLength": 1 },
        "rawContentIncluded": { "type": "boolean" },
        "itemLicenseVerified": { "type": "boolean" },
        "itemRightsEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["createdBy", "createdAt", "rightsGrantReference", "verifiedBy", "verifiedAt", "publicRepoPermission", "rawIngestionPermission"],
          "properties": {
            "createdBy": { "type": "string", "minLength": 1 },
            "createdAt": { "type": "string", "format": "date" },
            "rightsGrantReference": { "type": "string", "minLength": 1 },
            "verifiedBy": { "type": "string", "minLength": 1 },
            "verifiedAt": { "type": "string", "format": "date" },
            "publicRepoPermission": { "enum": ["YES", "NO", "NOT_ALLOWED", "CONDITIONAL", "UNKNOWN"] },
            "rawIngestionPermission": { "enum": ["YES", "NO", "NOT_ALLOWED", "CONDITIONAL", "UNKNOWN"] }
          }
        },
        "attributionText": { "type": "string" },
        "sourceVersion": { "type": "string" },
        "changeDescription": { "type": "string" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "useMode": { "const": "CONTENT_SOURCE" } },
            "required": ["useMode"]
          },
          "then": { "required": ["itemRightsEvidence"] }
        }
      ]
    },
    "targetCore": {
      "type": "object",
      "required": ["id", "targetType", "approvalStatus", "rationale", "evidence", "difficultyEvidence", "sourceProvenance"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "targetType": { "enum": ["SKILL", "VOCABULARY", "GRAMMAR", "CHARACTER"] },
        "approvalStatus": { "$ref": "#/$defs/approvalStatus" },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "difficultyEvidence": { "$ref": "#/$defs/difficultyEvidence" },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description", "evidenceIds"],
      "properties": {
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "evidenceBoundRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description", "evidenceIds"],
      "properties": {
        "required": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "skillNode": {
      "allOf": [
        { "$ref": "#/$defs/targetCore" },
        {
          "type": "object",
          "required": ["skillId", "domain", "capability", "description", "level", "prerequisites", "targetVocabulary", "targetGrammar", "targetCharacters", "productiveRequirement", "receptiveRequirement"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "targetType": { "const": "SKILL" },
            "skillId": { "$ref": "#/$defs/id" },
            "domain": { "enum": ["listening", "speaking", "reading", "recognition", "writing", "pronunciation", "phonetics", "vocabulary", "grammar"] },
            "capability": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 },
            "level": { "$ref": "#/$defs/level" },
            "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "targetVocabulary": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "targetGrammar": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "targetCharacters": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "productiveRequirement": { "$ref": "#/$defs/requirement" },
            "receptiveRequirement": { "$ref": "#/$defs/requirement" },
            "rationale": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
            "difficultyEvidence": { "$ref": "#/$defs/difficultyEvidence" },
            "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
            "approvalStatus": { "$ref": "#/$defs/approvalStatus" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "vocabularyNode": {
      "allOf": [
        { "$ref": "#/$defs/targetCore" },
        {
          "type": "object",
          "required": ["traditional", "simplified", "pinyin", "zhuyin", "meanings", "frequencyEvidence", "introducedBySkill", "prerequisites", "requiresRecycling", "receptiveRequirement", "productiveRequirement"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "targetType": { "const": "VOCABULARY" },
            "traditional": { "type": "string", "minLength": 1 },
            "simplified": { "type": "string", "minLength": 1 },
            "pinyin": { "type": "string", "minLength": 1 },
            "zhuyin": { "type": ["string", "null"] },
            "meanings": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
            "frequencyEvidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
            "introducedBySkill": { "$ref": "#/$defs/id" },
            "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "requiresRecycling": { "type": "boolean" },
            "receptiveRequirement": { "$ref": "#/$defs/evidenceBoundRequirement" },
            "productiveRequirement": { "$ref": "#/$defs/evidenceBoundRequirement" },
            "rationale": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
            "difficultyEvidence": { "$ref": "#/$defs/difficultyEvidence" },
            "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
            "approvalStatus": { "$ref": "#/$defs/approvalStatus" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "grammarExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tokens", "sourceProvenance", "evidenceIds"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "tokens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sentenceToken" } },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "grammarNode": {
      "allOf": [
        { "$ref": "#/$defs/targetCore" },
        {
          "type": "object",
          "required": ["canonicalDescription", "levelEvidence", "prerequisites", "examples", "receptiveRequirement", "productiveRequirement", "receptiveProductivePolicy", "receptiveProductivePolicyEvidenceIds"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "targetType": { "const": "GRAMMAR" },
            "canonicalDescription": { "type": "string", "minLength": 1 },
            "levelEvidence": { "$ref": "#/$defs/difficultyEvidence" },
            "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "examples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/grammarExample" } },
            "receptiveRequirement": { "$ref": "#/$defs/evidenceBoundRequirement" },
            "productiveRequirement": { "$ref": "#/$defs/evidenceBoundRequirement" },
            "receptiveProductivePolicy": { "enum": ["RECEPTIVE_BEFORE_PRODUCTIVE", "NO_ORDER_CONSTRAINT", "NOT_APPLICABLE", "UNRESOLVED"] },
            "receptiveProductivePolicyEvidenceIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
            "rationale": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
            "difficultyEvidence": { "$ref": "#/$defs/difficultyEvidence" },
            "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
            "approvalStatus": { "$ref": "#/$defs/approvalStatus" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script", "reading", "sourceProvenance", "evidenceIds"],
      "properties": {
        "script": { "enum": ["TRADITIONAL", "SIMPLIFIED", "BOTH"] },
        "reading": { "type": "string", "minLength": 1 },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "characterNode": {
      "allOf": [
        { "$ref": "#/$defs/targetCore" },
        {
          "type": "object",
          "required": ["character", "exposureLevel", "recognitionLevel", "readingLevel", "writingLevel", "readings", "prerequisiteSkills"],
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "targetType": { "const": "CHARACTER" },
            "character": { "type": "string", "minLength": 1, "maxLength": 2 },
            "exposureLevel": { "oneOf": [{ "$ref": "#/$defs/level" }, { "type": "null" }] },
            "recognitionLevel": { "oneOf": [{ "$ref": "#/$defs/level" }, { "type": "null" }] },
            "readingLevel": { "oneOf": [{ "$ref": "#/$defs/level" }, { "type": "null" }] },
            "writingLevel": { "oneOf": [{ "$ref": "#/$defs/level" }, { "type": "null" }] },
            "readings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/reading" } },
            "prerequisiteSkills": { "type": "array", "items": { "$ref": "#/$defs/id" } },
            "rationale": { "type": "string", "minLength": 1 },
            "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
            "difficultyEvidence": { "$ref": "#/$defs/difficultyEvidence" },
            "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
            "approvalStatus": { "$ref": "#/$defs/approvalStatus" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "sentenceToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tokenType", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "tokenType": { "enum": ["VOCABULARY", "CHARACTER"] },
        "text": { "type": "string", "minLength": 1 }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "tokens", "evidenceIds", "sourceProvenance"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "tokens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sentenceToken" } },
        "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } }
      }
    },
    "masteryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skillId", "domain"],
      "properties": {
        "skillId": { "$ref": "#/$defs/id" },
        "domain": { "type": "string", "minLength": 1 }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activityId", "domain", "targetIds", "masteryTargets"],
      "properties": {
        "activityId": { "$ref": "#/$defs/id" },
        "domain": { "type": "string", "minLength": 1 },
        "targetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "masteryTargets": { "type": "array", "items": { "$ref": "#/$defs/masteryTarget" } }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonId", "level", "skillIds", "availableSkillIds", "priorKnowledgeSkillIds", "priorRecognizedCharacterIds", "targetVocabularyIds", "targetGrammarIds", "targetCharacterIds", "availableTargetIds", "priorKnowledgeTargetIds", "newVocabularyIds", "recycledTargetIds", "sentences", "activities", "masteryTargets", "sourceProvenance", "rationale", "approvalStatus"],
      "properties": {
        "lessonId": { "$ref": "#/$defs/id" },
        "level": { "$ref": "#/$defs/level" },
        "skillIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "availableSkillIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "priorKnowledgeSkillIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "priorRecognizedCharacterIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "targetVocabularyIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "targetGrammarIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "targetCharacterIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "availableTargetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "priorKnowledgeTargetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "newVocabularyIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "recycledTargetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "sentences": { "type": "array", "items": { "$ref": "#/$defs/sentence" } },
        "activities": { "type": "array", "items": { "$ref": "#/$defs/activity" } },
        "masteryTargets": { "type": "array", "items": { "$ref": "#/$defs/masteryTarget" } },
        "sourceProvenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceProvenance" } },
        "rationale": { "type": "string", "minLength": 1 },
        "approvalStatus": { "$ref": "#/$defs/approvalStatus" }
      }
    },
    "validationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "approved"],
      "properties": {
        "policyId": { "$ref": "#/$defs/id" },
        "approved": { "type": "boolean" },
        "maxNewVocabularyRatio": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidenceIds": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },
    "proposalPrerequisite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "rationale"],
      "properties": {
        "targetId": { "$ref": "#/$defs/id" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "proposalAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternativeId", "description", "rationale", "evidenceIds"],
      "properties": {
        "alternativeId": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "proposalLoadDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "estimatedImpact", "targetIds", "rationale", "evidenceIds"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "estimatedImpact": { "type": "string", "minLength": 1 },
        "targetIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "proposalConfidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "rationale", "evidenceIds", "limitations"],
      "properties": {
        "estimate": { "type": "number", "minimum": 0, "maximum": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "curriculumChangeProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposalId", "documentType", "changeType", "affectedTargetIds", "proposedNodes", "whyNow", "prerequisites", "authorityEvidenceIds", "difficultyEvidenceIds", "alternativesConsidered", "expectedCognitiveLoad", "confidence", "unresolvedQuestions", "rationale", "evidence", "approvalStatus"],
      "properties": {
        "proposalId": { "$ref": "#/$defs/id" },
        "documentType": { "const": "CURRICULUM_CHANGE_PROPOSAL" },
        "changeType": { "enum": ["ADD_TARGET", "MODIFY_TARGET", "REMOVE_TARGET", "CHANGE_PREREQUISITE", "CHANGE_SEQUENCE"] },
        "affectedTargetIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "proposedNodes": { "type": "array", "items": { "oneOf": [{ "$ref": "#/$defs/skillNode" }, { "$ref": "#/$defs/vocabularyNode" }, { "$ref": "#/$defs/grammarNode" }, { "$ref": "#/$defs/characterNode" }] } },
        "whyNow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rationale", "evidenceIds"],
          "properties": {
            "rationale": { "type": "string", "minLength": 1 },
            "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
          }
        },
        "prerequisites": { "type": "array", "items": { "$ref": "#/$defs/proposalPrerequisite" } },
        "authorityEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "difficultyEvidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "alternativesConsidered": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proposalAlternative" } },
        "expectedCognitiveLoad": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions"],
          "properties": {
            "dimensions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/proposalLoadDimension" } }
          }
        },
        "confidence": { "$ref": "#/$defs/proposalConfidence" },
        "unresolvedQuestions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidence" } },
        "approvalStatus": { "const": "PROPOSED" }
      },
      "allOf": [
        {
          "if": { "properties": { "changeType": { "const": "REMOVE_TARGET" } }, "required": ["changeType"] },
          "then": { "properties": { "proposedNodes": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "changeType": { "enum": ["ADD_TARGET", "MODIFY_TARGET", "CHANGE_PREREQUISITE", "CHANGE_SEQUENCE"] } }, "required": ["changeType"] },
          "then": { "properties": { "proposedNodes": { "minItems": 1 } } }
        }
      ]
    }
  }
}
